# ── Public ────────────────────────────────────────────
# Public base URL (used in share links, certificates, emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Calendly (or any scheduling) link embedded in "Book a Scrini AI demo"
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-team/scrini-ai-demo
# Privacy policy version stamped onto each consent record
NEXT_PUBLIC_POLICY_VERSION=2026-11-v1

# ── Admin ─────────────────────────────────────────────
# Password for /admin (required in production)
ADMIN_PASSWORD=change-me
# Random string used to sign admin cookies
ADMIN_SECRET=please-generate-a-long-random-string

# ── Database (optional) ───────────────────────────────
# If both are set, Supabase is used (run supabase/schema.sql first).
# Otherwise a local JSON file store in ./.data is used (dev / single server only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Integrations (all optional) ───────────────────────
# Generic CRM webhook fired on every lead submit (Zoho Flow / HubSpot / Google Apps Script / Zapier)
LEAD_WEBHOOK_URL=
# Slack incoming-webhook for Hot-lead alerts
SLACK_WEBHOOK_URL=
# Transactional email via Resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="Scrini AI <hello@scrini.ai>"
# Comma-separated sales inbox(es) that get Hot-lead alert emails
SALES_ALERT_EMAILS=
